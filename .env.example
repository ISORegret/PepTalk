# Supabase (https://supabase.com) — copy to `.env` in project root and fill from Project Settings → API
# Rebuild the app after changing (Vite embeds these at build time).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: HTTPS URL of a JSON manifest (see public/peptalk-update-manifest.example.json).
# Host this file on your website when you publish a new APK; the app compares latestVersion to APP_VERSION.
# Your server must send CORS headers if the app origin differs from the manifest host.
# VITE_APP_UPDATE_MANIFEST_URL=https://your-site.com/peptalk-update.json
